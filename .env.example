# Database (PostgreSQL 18)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=smartdialer
POSTGRES_TEST_DB=smartdialer_test

# Optional Explicit URLs
# DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/smartdialer
# ASYNC_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/smartdialer

# Safety & Recovery Timing
SAFETY_MAX_ABANDONMENT_RATE=0.03
AGENT_RESERVATION_TIMEOUT_SECONDS=30
BORROWER_RESERVATION_TIMEOUT_SECONDS=45
CALL_RINGING_TIMEOUT_SECONDS=60
OUTBOX_POLL_INTERVAL_SECONDS=0.25

# Optional Real PSTN Calling via Twilio (local Provider A/B simulators work without these)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
